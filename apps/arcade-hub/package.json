{
  "name": "arcade-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Party arcade hub: one join, game voting, scoring and leaderboards across separate games.",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/main.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
